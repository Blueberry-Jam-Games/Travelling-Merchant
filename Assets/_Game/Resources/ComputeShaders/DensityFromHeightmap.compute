#pragma kernel Density
#include "/Includes/FastNoiseLite.hlsl"

// Noise settings
RWStructuredBuffer<float4> points;
RWStructuredBuffer<float> HeightmapBuffer;
// int octaves;
// float lacunarity;
// float persistence;
// float noiseScale;
// float noiseWeight;
// float weightMultiplier;
float hardFloor;
float hardFloorWeight;

static const int numThreads = 8;

int numPointsPerAxis;
float boundsSize;
float3 centre;
float spacing;
int seed;

int indexFromCoord(int x, int y, int z) {
    return z * numPointsPerAxis * numPointsPerAxis + y * numPointsPerAxis + x;
}

int index2dFromCoord(int x, int y)
{
    return y * numPointsPerAxis + x;
}

[numthreads(numThreads,numThreads,numThreads)]
void Density (int3 id : SV_DispatchThreadID)
{
    if (id.x >= numPointsPerAxis || id.y >= numPointsPerAxis || id.z >= numPointsPerAxis) {
        return;
    }

    fnl_state noise = fnlCreateState(seed);
    noise.noise_type = FNL_NOISE_OPENSIMPLEX2;

    float3 pos = centre + id * spacing - boundsSize/2;

    // float noise = 0;

    // float frequency = noiseScale/100;
    // float amplitude = 5;
    // float weight = 1;
    // for (int j =0; j < octaves; j ++) {
    //     float n = fnlGetNoise2D(pos * frequency);
    //     float v = 1-abs(n);
    //     v = v*v;
    //     v *= weight;
    //     weight = max(min(v*weightMultiplier,1),0);
    //     noise += v * amplitude;
    //     amplitude *= persistence;
    //     frequency *= lacunarity;
    // }
    int heightmapIndex = index2dFromCoord(id.x, id.z);
    float finalVal = - (HeightmapBuffer[heightmapIndex] - pos.y);
 
    if (pos.y < hardFloor) {
        finalVal += hardFloorWeight;
    }

    int index = indexFromCoord(id.x,id.y,id.z);

    float3 localPos = id * spacing;
    points[index] = float4(localPos, finalVal);
}
