#pragma kernel Heightmapper
#include "/Includes/HeightFromPos.hlsl"

RWStructuredBuffer<float> HeightmapBuffer;

int4 chunkPosition;
int heightmapResolution;
int minorPerMajorChunks;
float majorChunkSize;
float minorChunkSize;
int seed;
int chunkOffset;

[numthreads(8,8,1)]
void Heightmapper(uint3 id : SV_DispatchThreadID)
{
    if (id.x >= heightmapResolution || id.y >= heightmapResolution)
        return;

    uint index = id.x + id.y * heightmapResolution;

    float2 chunkBase = (float2)chunkPosition.xy * majorChunkSize;

    float2 pos = (float2(id.x, id.y) + float2(chunkOffset, chunkOffset)) * minorChunkSize + chunkBase;

    float height = GetTerrainHeight(pos, seed);

    HeightmapBuffer[index] = height;
}